{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./*"],
      "next/image": ["./components/ui/ImageAdapter.tsx"],
      "next/link": ["./components/ui/LinkAdapter.tsx"],
      "next/navigation": ["./lib/navigation/NavigationAdapter.tsx"]
    }
  },
  "include": ["src", "app", "components", "lib", "vite.config.ts"],
  "exclude": ["node_modules", "tests", "scripts", "scratch", "dist"]
}
