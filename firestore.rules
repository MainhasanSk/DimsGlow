rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      // User can read and update their own profile (with allowed fields only)
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'status']);
      allow delete: if false; // Profiles are deactivated/soft-deleted server-side
    }

    // 2. User Access & Permissions (Strictly server-managed)
    match /userAccess/{userId} {
      allow read: if isOwner(userId); // User can read their own assigned permissions
      allow write: if false; // Client writes strictly prohibited
    }

    // 3. Products & Variants (Public read for published, write server-only)
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && request.auth.token.role != null && request.auth.token.role != 'customer');
      allow write: if false;

      match /variants/{variantId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 4. Categories & Content (Public read for published)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /siteContent/{contentId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // 5. Persistent Carts, Favorites, and Addresses (Strictly isolated to owning UID)
    match /carts/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /favorites/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /addresses/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // 6. Orders & Timeline Events
    match /orders/{orderId} {
      // Customers can only read their own orders; mutations strictly server-only
      allow read: if isAuthenticated() && resource.data.customerUid == request.auth.uid;
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // 7. Invoices (Server-managed, protected downloads)
    match /invoices/{invoiceId} {
      allow read, write: if false; // All invoice access is gated through authenticated server endpoint
    }

    // 8. Reviews & Ratings (Approved reviews publicly readable, mutations server-authorized)
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false; // Customer submissions and staff moderation routed through server API
    }

    // 9. Operations & Finance: Suppliers, Purchase Orders, Expenses (Strictly server-only)
    match /suppliers/{supplierId} {
      allow read, write: if false;
    }

    match /purchaseOrders/{poId} {
      allow read, write: if false;
    }

    match /expenses/{expenseId} {
      allow read, write: if false;
    }

    // 10. CRM Customer Notes & History (Strictly server-only)
    match /crmNotes/{customerId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /crmProfiles/{allPaths=**} {
      allow read, write: if false;
    }

    // 11. Audits, Ledgers, Reports, Settings (Strictly server-only)
    match /stockMovements/{movementId} {
      allow read, write: if false;
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /dashboardAggregates/{aggregateId} {
      allow read, write: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Default deny rule for any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
