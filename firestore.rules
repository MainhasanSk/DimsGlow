rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read everything
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Users can write their own profile
    match /customers/{userId} {
      allow create, update, delete: if request.auth.uid == userId;
    }

    // Admins can write anywhere
    match /{document=**} {
      allow write: if request.auth.token.admin == true;
    }

    // Specific collections where users can write directly
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.customerId || request.auth.token.admin == true;
    }

    match /reviews/{reviewId} {
      allow create: if request.auth != null;
      allow update, delete: if request.auth.token.admin == true || request.auth.uid == resource.data.authorId;
    }

    match /expenses/{expenseId} {
      allow create, update, delete: if request.auth.token.admin == true;
    }

    match /staff/{staffId} {
      allow create, update, delete: if request.auth.token.admin == true;
    }

    match /crm/{crmId} {
      allow create, update, delete: if request.auth.token admin == true;
    }

    match /invoices/{invoiceId} {
      allow read: if request.auth != null;
      // only admin functions write invoices
      allow create, update, delete: if request.auth.token.admin == true;
    }

    match /audit/{auditId} {
      allow read: if request.auth.token.admin == true;
      allow write: if request.auth.token.admin == true;
    }

    // Low stock alerts are read‑only for clients, written by admin function
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
  }
}
